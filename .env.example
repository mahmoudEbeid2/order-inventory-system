PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=orders_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=orders_db
# Set host to "postgres" for Docker Compose, or "localhost" for local setup
DATABASE_URL=postgresql://orders_user:your_postgres_password@postgres:5432/orders_db?schema=public

# Redis Configuration (BullMQ & Idempotency)
# Set host to "redis" for Docker Compose, or "localhost" for local setup
REDIS_URL=redis://redis:6379

# Admin Seeding Credentials
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email SMTP Server Configuration (e.g. Mailtrap)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
